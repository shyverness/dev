{
	"layer": "top",
	"position": "top",
	"output": "HDMI-A-1",
	"exclusive": true,
	"modules-left": [
		"sway/workspaces",
		"sway/window"
	],
	"modules-right": [
		"clock",
		"tray"
	],
	"sway/workspaces": {
	},
	"sway/window": {
		"format": "{}"
	},
	"tray": {
		"show-passive-items": "true"
	},
	"clock": {
		"interval": 1,
		"tooltip": true,
		"format": "{:%Y.%m.%d %H:%M:%S}"
	}
}
