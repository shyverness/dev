{
	"layer": "top",
	"position": "top",
	"output": "HDMI-A-1",
	"exclusive": true,
	"modules-left": [
		"dwl/tags",
		"custom/sep",
		"dwl/window"
	],
	"modules-right": [
		"clock",
		"tray"
	],
	"dwl/tags": {
		"all-outputs": false,
		"hide-vacant": true
	},
	"dwl/window": {
		"format": "{layout}{title}",
		"hide-empty": true
	},
	"tray": {
		"show-passive-items": "true"
	},
	"clock": {
		"interval": 1,
		"tooltip": true,
		"format": "{:%Y.%m.%d %H:%M:%S}"
	}
}
