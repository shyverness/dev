#!/usr/bin/env bash

~/.config/i3/xrandr.sh &
~/.config/i3/i3-cycle-focus.py --history 2 &

blueman-applet &
ckb-next-daemon &
dunst &
nm-applet &
udiskie --tray &
mpd --no-daemon ~/.config/mpd.conf &
protonmail-bridge &


unclutter --timeout 15 &
gammastep -m randr -l 46.3:-72.5 &
greenclip daemon &
xautolock -time 5 -locker "i3lock -c 191724" &

setxkbmap ca
setxkbmap -layout ca
xset r rate 225 100
xset s off
xset dpms 6000 6000 6000
xset m 0 0

sleep 1

~/.config/polybar/launch.sh &
nitrogen --restore
