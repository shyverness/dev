#!/usr/bin/env zsh

dir=$(
  {
    fd . ~/Desktop/
    fd . ~/.config ~/Downloads
  } | fzf --preview 'tree -L2 {}') || exit

[[ -n "$dir" ]] || exit

name="$(basename $(dirname "$dir")) $(basename "$dir")"

if [[ "$TERM" == "tmux-256color" ]]
 		then
	session=$(tmux new-session -dP -F '#{session_id}' -c "$dir" -s "$name") || exit
	tmux switch-client -t "$session"
else
	tmux new-session -c "$dir" -s "$name"
fi
